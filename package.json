{
  "name": "@tc39/tc39.github.io",
  "private": true,
  "description": "Get involved in specifying JavaScript",
  "repository": {
    "type": "git",
    "url": "https://github.com/tc39/tc39.github.io.git"
  },
  "type": "module",
  "scripts": {
    "prebuild": "npm run sass",
    "build": "eleventy",
    "fix": "npm run fix:ultracite && npm run fix:scss",
    "fix:ultracite": "ultracite fix",
    "fix:scss": "npm run lint:scss -- --fix",
    "lint": "npm run lint:ultracite && npm run lint:scss",
    "lint:ultracite": "ultracite check",
    "lint:scss": "stylelint _sass",
    "sass": "sass --style=compressed _sass/style.scss assets/css/style.css",
    "sass:watch": "sass --style=compressed _sass/style.scss assets/css/style.css --watch",
    "start": "eleventy --serve --watch",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "devDependencies": {
    "@11ty/eleventy": "3.1.7",
    "@11ty/eleventy-fetch": "6.0.1",
    "@primer/octicons": "19.42.0",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "sass-embedded": "1.106.1",
    "stylelint": "17.16.0",
    "stylelint-config-recess-order": "7.9.0",
    "stylelint-config-standard-scss": "17.0.0",
    "stylelint-order": "8.1.2",
    "ultracite": "8.1.0"
  },
  "engines": {
    "node": ">=24"
  }
}
